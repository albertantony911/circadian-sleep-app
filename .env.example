# ==============================================================================
# Circadian & Sleep Analytics Web App (Nadir / Grip Alternative)
# Environment Configuration
# ==============================================================================

# Database Connection (PostgreSQL)
# When set, connects via standard pg client to Neon, Supabase, RDS, or local Docker Postgres.
# When left blank or unset in local development, automatically falls back to embedded PGlite.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/circadian_sleep

# Auth & Ingestion Secrets
AUTH_SECRET=f3c8a98b2c1248439b1a508f7db018ec4976a147055047b1981a8b3e8c1482ef
CRON_SECRET=cron_secret_key_change_me_in_production

# Cloud OAuth Providers (Fitbit Web API)
# Register app at https://dev.fitbit.com/apps/new (OAuth 2.0 Application Type: Server)
FITBIT_CLIENT_ID=23XXXX
FITBIT_CLIENT_SECRET=abcdef1234567890abcdef1234567890
FITBIT_REDIRECT_URI=http://localhost:3000/api/auth/callback/fitbit

# Cloud OAuth Providers (Google Health Connect REST / Google Fitness)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-yourgoogleclientsecret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
